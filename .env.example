# Application
ENV=development
ADMIN_TOKEN=change-me-in-prod-please
# Production public base URL (QR login + UI links behind Apache prefix, e.g. https://host/technodt)
QR_BASE_URL=

# Database
DATABASE_URL=postgresql+asyncpg://convert_track:convert_track@localhost:5433/convert_track
DATABASE_URL_TEST=postgresql+asyncpg://convert_track:convert_track@localhost:5433/convert_track_test

# 1С OData
ODATA_BASE_URL=http://example.invalid/odata/standard.odata
ODATA_ADMIN_USER=odata.admin
ODATA_PASSWORD=replace-me
ODATA_TIMEOUT_SECONDS=60

# Envelope barcode
ENVELOPE_BC_PREFIX=

# Initial admin credentials (web + Android TSD login)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=0000

# Auth cookie lifetime for web and Android TSD clients
AUTH_COOKIE_MAX_AGE_SECONDS=28800

# Android TSD printers
# Example: [{"id":"zpl-main","name":"Zebra склад","kind":"zpl","host":"192.168.1.50","port":9100,"dpi":200}]
PRINTERS_JSON=[]

# A4 direct print via SumatraPDF
PRINT_SERVER_HOST=10.60.6.11
SUMATRA_EXE_PATH=tools/SumatraPDF-3.6.1-64.exe
PRINT_TEMP_DIR=tools/temp
SUMATRA_TIMEOUT_SECONDS=90

# v2.0 sync and paperless integration
PAPERLESS_WEBHOOK_API_KEY=change_me_strong_token
# Required for webhook post-consume: fetch metadata.media_filename and build UNC for 1C.
PAPERLESS_API_URL=http://localhost:8000
PAPERLESS_API_TOKEN=paperless_user_api_token
PAPERLESS_MARK_TAG_ID=52
PAPERLESS_ERROR_TAG_ID=53
PAPERLESS_ONEC_ORIGINALS_UNC_ROOT=\\kaz-pc036\Техно-Архив
PAPERLESS_ONEC_ARCHIVE_UNC_ROOT=
PAPERLESS_POLL_INTERVAL_MINUTES=0
PAPERLESS_POLL_BATCH_SIZE=50
SYNC_INITIAL_FROM_DATE=2023-01-01
SYNC_SCHEDULE_HOURS=4
